{
  "name": "supera-monitor-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0  --watch=true --poll=2000",
    "start:ssl": "ng serve --ssl true --host 0.0.0.0",
    "start:fast": "ng serve --host 0.0.0.0 --configuration=development --poll=2000",
    "build": "ng build",
    "build:dev": "ng build --configuration=development",
    "build:prod": "ng build --configuration=production",
    "clean": "rimraf dist .angular/cache",
    "clean:cache": "rimraf .angular/cache",
    "optimize": "npm run clean:cache && npm start"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.1.3",
    "@angular/cdk": "^19.1.1",
